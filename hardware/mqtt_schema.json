{
  "protocol": "MQTT v3.1.1 / v5.0",
  "broker": "broker.hivemq.com (or local Mosquitto: 1883)",
  "topics": {
    "telemetry": {
      "topic": "aurasense/room1/telemetry",
      "direction": "ESP32 -> Broker -> Dashboard",
      "payload_example": {
        "hardwareId": "ESP32-MASTER-01",
        "temperature": 28.4,
        "humidity": 58.2,
        "lux": 780,
        "timestamp": 1728734120
      }
    },
    "command": {
      "topic": "aurasense/room1/command",
      "direction": "Dashboard -> Broker -> ESP32",
      "payload_example": {
        "deviceId": "fan",
        "targetState": "ON",
        "speed": 3,
        "commandId": "cmd-8273"
      }
    },
    "status_feedback": {
      "topic": "aurasense/room1/status",
      "direction": "ESP32 -> Broker -> Dashboard",
      "payload_example": {
        "deviceId": "fan",
        "confirmedState": "ON",
        "relayPin": 26,
        "ack": true
      }
    }
  }
}
